<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
  name="fs_ai_agent"
  title="AI Agent"
  width="480"
  height="480"
  min_width="320"
  min_height="300"
  single_instance="true"
  save_rect="true"
  save_visibility="false"
  can_resize="true"
  can_minimize="true"
  can_close="true"
  layout="topleft">

  <text_editor
    name="chat_history"
    layout="topleft"
    follows="all"
    left="8"
    top="28"
    right="-8"
    bottom="-60"
    read_only="true"
    word_wrap="true"
    font="SansSerif"
    bg_readonly_color="TextBgReadOnlyColor"
    bg_visible="true"
    border_visible="true" />

  <line_editor
    name="user_input"
    layout="topleft"
    follows="left|right|bottom"
    left="8"
    right="-90"
    bottom="-32"
    height="24"
    max_length="512"
    label="Ask something..."
    font="SansSerif" />

  <button
    name="send_btn"
    layout="topleft"
    follows="right|bottom"
    right="-8"
    bottom="-32"
    width="76"
    height="24"
    label="Send"
    tool_tip="Send message to AI agent (Enter)" />

</floater>
